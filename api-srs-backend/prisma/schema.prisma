// Configurações de Gerador e Datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums do Sistema ---

enum StudyMode {
  STANDARD
  CHAOS
}

enum DeviceType {
  PWA
  IOT
  WEB
}

// --- Modelos de Dados ---

model User {
  id                    String         @id @default(uuid()) @db.Uuid
  authId                String         @unique // Vínculo com Supabase Auth
  name                  String?
  email                 String         @unique
  isAnonymized          Boolean        @default(false)

  // CORREÇÃO: Adicionado timezone para viabilizar o Rollover Temporal (RN06)
  timezone              String         @default("America/Sao_Paulo")

  // Gamificação e Configurações
  totalXp               Int            @default(0)
  fsrsWeights           Json?          // Pesos otimizados do ML para este usuário
  dailyNewCardLimit     Int            @default(20)
  maxDailyReviews       Int            @default(100)
  currentStreak         Int            @default(0)
  longestStreak         Int            @default(0)

  // Timestamps
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lastDataExportAt      DateTime?
  lastNotificationSentAt DateTime?

  // Relacionamentos
  decks                 Deck[]
  reviewLogs            ReviewLog[]
  studySessions         StudySession[]

  // CORREÇÃO: Necessário referenciar a nova relação para o FSRS Data
  fsrsData              CardFSRSData[]

  @@map("users")
}

model Deck {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  sourceLanguage  String?        @default("pt-BR")
  targetLanguage  String?
  isArchived      Boolean        @default(false)

  // Metadados
  creatorId       String         @db.Uuid

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relacionamentos
  flashcards      Flashcard[]
  tags            DeckTag[]

  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@map("decks")
}

model Flashcard {
  id              String         @id @default(uuid()) @db.Uuid // UUID
  front           String         @db.Text
  back            String         @db.Text
  sourceContext   String?        @db.Text // Referencial original/contexto

  // CORREÇÃO: Adicionados campos para RF11 (Multimídia)
  imageUrl        String?        @db.Text
  audioUrl        String?        @db.Text

  deckId          String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relacionamentos
  // CORREÇÃO: Agora um flashcard possui múltiplos metadados FSRS (um por usuário)
  fsrsData        CardFSRSData[]
  reviewLogs      ReviewLog[]
  tags            FlashcardTag[]

  deck            Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  // Índice B-Tree crucial para o desempenho do Modo Chaos (O(log n))
  @@map("flashcards")
}

model CardFSRSData {
  id              String         @id @default(uuid()) @db.Uuid
  // CORREÇÃO: Removido o @unique direto para permitir Desacoplamento e Marketplace
  flashcardId     String         @db.Uuid
  // CORREÇÃO: Inclusão do Usuário dono deste progresso
  userId          String         @db.Uuid

  // Atributos do Algoritmo FSRS
  stability       Float          @default(0)
  difficulty      Float          @default(0)
  elapsedDays     Int            @default(0)
  scheduledDays   Int            @default(0)
  reps            Int            @default(0)
  lapses          Int            @default(0)

  // State: 0: NEW, 1: LEARNING, 2: REVIEW, 3: RELEARNING (FSRS Default)
  state           Int            @default(0)
  lastReview      DateTime?
  due             DateTime       @default(now()) // Inicializa pendente para o dia atual

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  flashcard       Flashcard      @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CORREÇÃO VITAL: Chave única composta. Um usuário tem apenas 1 progresso para 1 card específico.
  @@unique([flashcardId, userId])
  @@index([userId, due]) // OTIMIZAÇÃO: Melhora exponencialmente o "Modo Chaos" onde buscamos por User + Due Date
  @@map("card_fsrs_data")
}

model ReviewLog {
  id                String       @id @default(uuid())
  // Relacionamentos
  flashcardId       String       @db.Uuid
  userId            String       @db.Uuid

  rating            Int          // 1: Errei, 2: Difícil, 3: Bom, 4: Fácil
  reviewDurationMs  Int          // Latência de resposta para telemetria
  elapsedDays       Int          @default(0)   //os dias decorridos desde a última revisão

  // CORREÇÃO: Flag de Fadiga Cognitiva (RN08)
  isFatiguedReview  Boolean      @default(false)

  // Snapshots FSRS para treinamento de ML (Immutable Data)
  stabilityBefore   Float
  difficultyBefore  Float
  stabilityAfter    Float
  difficultyAfter   Float

  createdAt         DateTime     @default(now())

  flashcard         Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("review_logs")
}

model StudySession {
  id                String       @id @default(uuid()) @db.Uuid
  startAt           DateTime     @default(now())
  finishAt          DateTime?
  deviceType        DeviceType   @default(WEB)
  studyMode         StudyMode    @default(STANDARD)

  // Cache de performance da sessão
  cardsReviewed     Int          @default(0)
  correctCount      Int          @default(0)
  wrongCount        Int          @default(0)
  xpEarned          Int          @default(0)

  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  biometricLogs BiometricLog[]

  @@map("study_sessions")
}

// --- Tabelas de Categorização ---

model Tag {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  decks       DeckTag[]
  flashcards  FlashcardTag[]

  @@map("tags")
}

model DeckTag {
  deckId          String         @db.Uuid
  tagId           String         @db.Uuid
  deck            Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tag             Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deckId, tagId])
  @@map("deck_tags")
}

model FlashcardTag {
  flashcardId     String          @db.Uuid
  tagId           String          @db.Uuid
  flashcard       Flashcard       @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  tag             Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([flashcardId, tagId])
  @@map("flashcard_tags")
}

model BiometricLog {
  id           String      @id @default(uuid()) @db.Uuid

  // OBRIGATÓRIO: Paridade com StudySession.id
  sessionId    String      @db.Uuid

  fatigueLevel Float?
  bpm          Int?
  recordedAt   DateTime    @default(now())

  session      StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("biometric_logs")
}